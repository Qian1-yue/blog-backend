# 请为生产环境生成三个不同的强密码，不要提交实际的 .env 文件。
DB_USERNAME=blog_app
DB_PASSWORD=replace-with-a-strong-password
MYSQL_ROOT_PASSWORD=replace-with-another-strong-password
REDIS_PASSWORD=replace-with-a-third-strong-password

# 无域名时使用 :80；绑定域名后改成 blog.example.com，Caddy 会自动申请 HTTPS 证书。
SITE_ADDRESS=:80
HTTP_PORT=80
HTTPS_PORT=443

JAVA_OPTS=-XX:MaxRAMPercentage=75.0 -XX:+ExitOnOutOfMemoryError
